# Puerto HTTP de la app
PORT=8000

# Opción 1: URL completa de conexión
DATABASE_URL=postgres://sofre:sofre@localhost:5432/sofre_python_test

# Opción 2: variables estándar de Postgres (se usan si no hay DATABASE_URL)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=sofre
# PGPASSWORD=sofre
# PGDATABASE=sofre_python_test

# Activar SSL hacia la base (true/false)
DATABASE_SSL=false

# Info opcional que muestra la UI (la puede inyectar el deployer)
APP_ENV=development
GIT_COMMIT=
DEPLOYED_AT=
